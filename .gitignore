# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Kiranico 詳細頁快取（import-unlocks.mjs 全量掃描用）
scripts/.kiranico-cache/

# Game8 文章快取（scrape-game8.js 用）
scripts/.game8-cache/

# Kiranico 日文列表頁快取（build-jp-name-map.js 用）
scripts/.cache/

# 爬蟲候選中繼產出（保留在本機供追溯；正式資料已上架 data/community-builds/，故不入版控）
scripts/output/

# World 匯入管線快取（MHWorldData raw CSV + Kiranico World 交叉稽核快取；重跑零抓取）
scripts/world/.cache/

# World 推薦配裝 Game8 文章快取（scrape-game8-mhwi.mjs 用；重跑零抓取）
scripts/world/.game8-mhwi-cache/

# Wilds 匯入管線快取（mhdb-wilds API en+zh-Hant 抓取；重跑零抓取）。
# ★ Phase 6b 修正：原本連 Game8 抽取結果一併忽略，導致跨機開發時快取遺失（單副本風險已實際
#   發生）。改為：原始 HTML（.cache/html，大、可重抓）續忽略；Game8 **抽取結果**（.cache/game8/*.json，
#   結構化事實資料、含 provenance）**進版控**——「首抓固化」由 git 歷史強制，比 gitignore 更忠於原意。
#   理由與推翻留痕見 docs/wilds-game8-audit.md「快取版控修正」節。
scripts/wilds/.cache/*
!scripts/wilds/.cache/game8/
